#include <Arduino.h>
#include <NimBLEDevice.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// ==========================================
// CONFIGURATION & PINS
// ==========================================
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET    -1
#define SCREEN_ADDRESS 0x3C

#define I2C_SDA        8
#define I2C_SCL        9
#define BUZZER_PIN     6

#define FRONT_MAC     "b9:41:fa:00:46:64"
#define REAR_MAC      "b9:41:fa:00:48:81"

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

struct TireData {
  float pressure;
  float temp;
  float voltage;
  unsigned long lastUpdate;
  bool active;
  bool hasConnectedOnce;
  std::string lastRawData;
};

TireData frontTire = {0.0f, 0.0f, 3.0f, 0, false, false, ""};
TireData rearTire  = {0.0f, 0.0f, 3.0f, 0, false, false, ""};

bool displayNeedsUpdate = true;
unsigned long lastPacketCheck = 0;

// ==========================================
// BLE SCAN CALLBACKS & DECODER
// ==========================================
class TPMSCallbacks : public NimBLEScanCallbacks {
  void onResult(const NimBLEAdvertisedDevice* device) override {
    String mac = String(device->getAddress().toString().c_str());
    mac.toLowerCase();

    // Filter for front and rear sensors only
    String position = "";
    if (mac == FRONT_MAC) position = "FRONT";
    else if (mac == REAR_MAC) position = "REAR";
    else return;

    if (device->haveManufacturerData()) {
      std::string data = device->getManufacturerData();
      if (data.length() < 11) return;

      std::string* lastRaw = (mac == FRONT_MAC) ? &frontTire.lastRawData : &rearTire.lastRawData;
      TireData* tire = (mac == FRONT_MAC) ? &frontTire : &rearTire;
      
      if (data != *lastRaw) {
        *lastRaw = data;

        Serial.print("[RAW CHANGED] ");
        Serial.print(position);
        Serial.print(" | Hex: ");
        for (size_t i = 0; i < data.length(); i++) {
          if ((uint8_t)data[i] < 0x10) Serial.print("0");
          Serial.print((uint8_t)data[i], HEX);
          Serial.print(" ");
        }
        Serial.println();
      }

      uint8_t statusFlag = (uint8_t)data[0]; // 0x04 = Unplugged, 0x05 = Active/Update, 0x06 = Unchanged/Heartbeat
      unsigned long now = millis();

      if (statusFlag == 0x04) {
        // Explicitly Unplugged
        tire->active = false;
        tire->pressure = 0.0f;
        tire->hasConnectedOnce = true;
        tire->lastUpdate = now;
        displayNeedsUpdate = true;

        Serial.print("[TPMS DECODED] ");
        Serial.print(position);
        Serial.println(" | State: 0x4 | Unplugged (0.0 PSI)");
      } 
      else if (statusFlag == 0x05) {
        // Active data update with new values
        uint8_t rawTemp  = (uint8_t)data[3]; 
        uint8_t rawPress = (uint8_t)data[5]; 

        float pressurePsi = (float)rawPress * 0.027f; 
        if (pressurePsi < 0.0f) pressurePsi = 0.0f;

        float tempC = (float)rawTemp - 50.0f; 

        tire->pressure = pressurePsi;
        tire->temp = tempC;
        tire->voltage = 3.0f;
        tire->lastUpdate = now;
        tire->active = true;
        tire->hasConnectedOnce = true;
        displayNeedsUpdate = true;

        Serial.print("[TPMS DECODED] ");
        Serial.print(position);
        Serial.print(" | State: 0x5 | Press: ");
        Serial.print(pressurePsi, 1);
        Serial.print(" PSI | Temp: ");
        Serial.print(tempC, 0);
        Serial.println(" C");
      } 
      else if (statusFlag == 0x06) {
        // Unchanged / Heartbeat state: preserve the active state and pressure that was already set
        if (tire->hasConnectedOnce) {
          tire->lastUpdate = now;
          displayNeedsUpdate = true;

          Serial.print("[TPMS DECODED] ");
          Serial.print(position);
          Serial.print(" | State: 0x6 | Maintaining State Active=");
          Serial.print(tire->active ? "TRUE" : "FALSE");
          Serial.print(" | Press: ");
          Serial.print(tire->pressure, 1);
          Serial.println(" PSI");
        }
      }
    }
  }
};

TPMSCallbacks callbacks;

void setup() {
  Serial.begin(115200);
  delay(1000);

  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  Wire.begin(I2C_SDA, I2C_SCL);
  if(!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    Serial.println(F("OLED allocation failed"));
    while(1);
  }

  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 20);
  display.println(F(" TPMS MONITOR "));
  display.println(F(" Initializing BLE..."));
  display.display();
  delay(1500);

  NimBLEDevice::init("");
  NimBLEScan* pBLEScan = NimBLEDevice::getScan();
  pBLEScan->setScanCallbacks(&callbacks, false);
  pBLEScan->setActiveScan(false);
  pBLEScan->setInterval(45);
  pBLEScan->setWindow(45);
  pBLEScan->setMaxResults(0); 
  pBLEScan->start(0, false);
}

void updateDisplay() {
  display.clearDisplay();
  display.drawFastVLine(64, 0, 64, SSD1306_WHITE);

  // --- FRONT COLUMN ---
  display.setTextSize(1);
  display.setCursor(3, 0);
  display.print(F("FRONT"));

  if (frontTire.hasConnectedOnce && frontTire.active) {
    display.setCursor(3, 11);
    display.setTextSize(2);
    display.print(frontTire.pressure, 1);
    
    display.setTextSize(1);
    display.setCursor(3, 29);
    display.print(F("PSI"));

    display.setCursor(3, 41);
    display.print((int)frontTire.temp);
    display.print(F("C "));
    display.print(frontTire.voltage, 1);
    display.print(F("V"));
  } else if (frontTire.hasConnectedOnce && !frontTire.active) {
    display.setCursor(3, 11);
    display.setTextSize(2);
    display.print(F("0.0"));
    
    display.setTextSize(1);
    display.setCursor(3, 29);
    display.print(F("PSI"));

    display.setCursor(3, 41);
    display.print(F("Unplugged"));
  } else {
    display.setCursor(3, 25);
    display.setTextSize(1);
    display.print(F("Waiting"));
  }

  // --- REAR COLUMN ---
  display.setTextSize(1);
  display.setCursor(68, 0);
  display.print(F("REAR"));

  if (rearTire.hasConnectedOnce && rearTire.active) {
    display.setCursor(68, 11);
    display.setTextSize(2);
    display.print(rearTire.pressure, 1);
    
    display.setTextSize(1);
    display.setCursor(68, 29);
    display.print(F("PSI"));

    display.setCursor(68, 41);
    display.print((int)rearTire.temp);
    display.print(F("C "));
    display.print(rearTire.voltage, 1);
    display.print(F("V"));
  } else if (rearTire.hasConnectedOnce && !rearTire.active) {
    display.setCursor(68, 11);
    display.setTextSize(2);
    display.print(F("0.0"));
    
    display.setTextSize(1);
    display.setCursor(68, 29);
    display.print(F("PSI"));

    display.setCursor(68, 41);
    display.print(F("Unplugged"));
  } else {
    display.setCursor(68, 25);
    display.setTextSize(1);
    display.print(F("Waiting"));
  }

  display.display();
}

void loop() {
  if (displayNeedsUpdate) {
    displayNeedsUpdate = false;
    updateDisplay();
  }

  NimBLEScan* pBLEScan = NimBLEDevice::getScan();
  
  if (!pBLEScan->isScanning()) {
    pBLEScan->start(0, false);
  } else {
    unsigned long currentMillis = millis();
    if (currentMillis - lastPacketCheck > 5000) {
      lastPacketCheck = currentMillis;
      pBLEScan->stop();
      delay(50);
      pBLEScan->start(0, false);
    }
  }
}
